# Clash / Mihomo application-level PROXY rules.

# Google Antigravity desktop application.
PROCESS-NAME,Antigravity.exe
PROCESS-PATH-REGEX,(?i)^C:\\Users\\[^\\]+\\AppData\\Local\\Programs\\antigravity\\.*

# OpenAI Codex / ChatGPT Windows application and all related helpers.
# Codex GUI processes may appear as ChatGPT.exe; both product names are forced through PROXY.
PROCESS-NAME,ChatGPT.exe
PROCESS-NAME,codex.exe
PROCESS-NAME,codex-code-mode-host.exe
PROCESS-PATH-REGEX,(?i)^C:\\Program Files\\WindowsApps\\OpenAI\.(Codex|ChatGPT)_[^\\]+\\.*
PROCESS-PATH-REGEX,(?i)^C:\\Users\\[^\\]+\\AppData\\Local\\OpenAI\\(Codex|ChatGPT)\\.*
PROCESS-PATH-REGEX,(?i)^C:\\Users\\[^\\]+\\\.(codex|chatgpt)\\.*
